# Supabase (Pro 요금제 프로젝트)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 세션 서명 + 2차 인증 비밀값 암호화용 (openssl rand -base64 32)
SESSION_SECRET=
# 생년월일 해시용 서버 비밀값 (openssl rand -base64 32). 한 번 정하면 바꾸지 마세요 —
# 바꾸면 등록된 학생 전원이 로그인할 수 없게 되어 명단을 다시 올려야 합니다.
BIRTHDATE_PEPPER=

# 메일에 넣을 사이트 주소 (예: https://absence.example.ac.kr)
APP_URL=

# 초대·로그인 메일 발송 (Resend). 비워 두면 메일을 보내지 않고, 학과장 화면에 링크를 보여 줘 직접 전달합니다.
RESEND_API_KEY=
EMAIL_FROM=
